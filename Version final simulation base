def inject_quality(df, rng):

n = len(df)

# =====================================================
# 1. AGE ERRORS (saisie / migration système)
# =====================================================
idx = rng.choice(n, int(0.01 * n), replace=False)
df.loc[idx, "age"] = rng.choice([-10, 0, 150], len(idx))

# =====================================================
# 2. REVENUE ISSUES (missing + incohérences)
# =====================================================
idx = rng.choice(n, int(0.02 * n), replace=False)
df.loc[idx, "revenu"] = np.nan

idx = rng.choice(n, int(0.005 * n), replace=False)
df.loc[idx, "revenu"] *= -1

# =====================================================
# 3. REGION DATA QUALITY (typos / missing)
# =====================================================
idx = rng.choice(n, int(0.015 * n), replace=False)
df.loc[idx, "region"] = rng.choice(
["IDF ", "Ile-de-France", "paris", None],
len(idx)
)

# =====================================================
# 4. COMMISSION INCOHERENCE (business rule violation)
# commission > prime (impossible mais fréquent en data brute)
# =====================================================
idx = rng.choice(n, int(0.01 * n), replace=False)
df.loc[idx, "commission_expected"] *= rng.uniform(1.2, 3.0, len(idx))

# =====================================================
# 5. FRAIS ANORMAUX (cost explosion / bug allocation)
# =====================================================
idx = rng.choice(n, int(0.01 * n), replace=False)
df.loc[idx, "frais_expected"] *= rng.uniform(2.0, 5.0, len(idx))

# =====================================================
# 6. SINISTRES EXTREMES (fraude / événements rares)
# =====================================================
idx = rng.choice(n, int(0.005 * n), replace=False)
df.loc[idx, "sinistres_expected"] *= rng.uniform(5, 15, len(idx))

# =====================================================
# 7. INCURRED DATA ISSUES (très réaliste en production)
# =====================================================

# incohérence incurred vs expected (tracking error)
idx = rng.choice(n, int(0.01 * n), replace=False)
df.loc[idx, "sinistres_incurred"] *= rng.uniform(0.5, 2.5, len(idx))

# primes delayed booking
idx = rng.choice(n, int(0.01 * n), replace=False)
df.loc[idx, "prime_incurred"] *= rng.uniform(0.95, 1.1, len(idx))

# =====================================================
# 8. SILENT SYSTEM BIAS (très important en IA/actuariat)
# =====================================================
df["commission_expected"] *= rng.normal(1.0, 0.01, n)
df["frais_expected"] *= rng.normal(1.0, 0.01, n)

return df



=========================================================
EXPORT
=========================================================
def export(df, meta, cfg):

os.makedirs(cfg["output_dir"], exist_ok=True)

file_path = os.path.join(
cfg["output_dir"],
f"bba_portfolio_{meta['run_id']}.csv"
)

df.to_csv(file_path, index=False)

pd.Series(meta).to_json(
os.path.join(cfg["output_dir"], f"metadata_{meta['run_id']}.json")
)

return file_path


=========================================================
MAIN
=========================================================
def main():

cfg = config()
rng = np.random.default_rng(cfg["seed"])
meta = run_metadata()

df = build_base(cfg["n"], rng)

df = compute_expected(df, rng)

df = compute_incurred(df, rng)

df = compute_bba(df, cfg)

df = inject_quality(df, rng)

file_path = export(df, meta, cfg)

meta["file"] = file_path

print("\n==============================")
print(" IFRS 17 BBA SIMULATION DONE")
print("==============================")
print(f"Run ID : {meta['run_id']}")
print(f"Timestamp : {meta['timestamp']}")
print(f"File saved : {file_path}")

print("\nPreview dataset:")
print(df.head())


