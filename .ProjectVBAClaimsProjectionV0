Option Explicit

Sub Generer_Projection_BF_Corrige()
    Dim wsBrut As Worksheet, wsHyp As Worksheet, wsTri As Worksheet
    Dim lastRow As Long, i As Long, j As Long
    Dim gen As Long
    Dim genMin As Long, genMax As Long, numGens As Long
    Dim matMinMature As Long, genMaxMature As Long
    Dim rowCadence As Long, yObsGen As Long
    Dim colObsLetter As String, colCurLetter As String, colUltLetter As String
    
    On Error Resume Next
    Set wsBrut = ThisWorkbook.Sheets("0_Donnees_Brutes")
    Set wsHyp = ThisWorkbook.Sheets("1_Hypotheses_et_Calibrage")
    Set wsTri = ThisWorkbook.Sheets("2_Triangle_SP_Pur")
    On Error GoTo 0
    
    If wsBrut Is Nothing Then
        MsgBox "Feuille '0_Donnees_Brutes' introuvable !", vbCritical
        Exit Sub
    End If
    
    ' Création des onglets de restitution si absents
    If wsHyp Is Nothing Then
        Set wsHyp = ThisWorkbook.Sheets.Add(After:=wsBrut)
        wsHyp.Name = "1_Hypotheses_et_Calibrage"
    End If
    If wsTri Is Nothing Then
        Set wsTri = ThisWorkbook.Sheets.Add(After:=wsHyp)
        wsTri.Name = "2_Triangle_SP_Pur"
    End If
    
    ' Paramètre : Nombre d'années de recul pour définir les générations "matures"
    matMinMature = 5
    
    Application.ScreenUpdating = False
    
    ' -------------------------------------------------------------
    ' 1. DÉTERMINATION DE LA PLAGE TEMPORELLE (GÉNÉRATIONS)
    ' -------------------------------------------------------------
    lastRow = wsBrut.Cells(wsBrut.Rows.Count, 1).End(xlUp).Row
    genMin = 9999
    genMax = 0
    
    For i = 2 To lastRow
        gen = Val(wsBrut.Cells(i, 1).Value) ' Col A: Génération
        If gen < genMin And gen > 1900 Then genMin = gen
        If gen > genMax Then genMax = gen
    Next i
    
    numGens = genMax - genMin + 1
    genMaxMature = genMax - matMinMature
    If genMaxMature < genMin Then genMaxMature = genMin

    ' -------------------------------------------------------------
    ' 2. PRÉPARATION DE LA STRUCTURE DU TRIANGLE S/P
    ' -------------------------------------------------------------
    wsTri.Cells.Clear
    wsTri.Cells(1, 1).Value = "Génération / Maturité"
    wsTri.Cells(1, 1).Font.Bold = True
    
    ' En-têtes Y1 à Y15
    For j = 1 To 15
        wsTri.Cells(1, j + 1).Value = "Y" & j
        wsTri.Cells(1, j + 1).Font.Bold = True
    Next j
    
    ' En-têtes Générations en Colonne A
    For i = 1 To numGens
        wsTri.Cells(i + 1, 1).Value = genMin + i - 1
    Next i

    ' -------------------------------------------------------------
    ' 3. ÉTAPE 1 : INJECTION DES DONNÉES RÉELLES CONSTATÉES (OBSERVÉ)
    ' -------------------------------------------------------------
    ' Col D = Primes / Col E = Sinistres / Col C = Maturité (ex: "Y1", "Y2")
    For i = 1 To numGens
        gen = genMin + i - 1
        yObsGen = genMax - gen + 1
        If yObsGen > 15 Then yObsGen = 15
        
        For j = 1 To yObsGen
            ' Formule SUMIFS gérant la maturité sous forme "Y1" ou "1"
            wsTri.Cells(i + 1, j + 1).Formula = "=IFERROR((" & _
                "SUMIFS('0_Donnees_Brutes'!E:E, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, ""Y" & j & """) + " & _
                "SUMIFS('0_Donnees_Brutes'!E:E, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & ")) / " & _
                "(" & _
                "SUMIFS('0_Donnees_Brutes'!D:D, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, ""Y" & j & """) + " & _
                "SUMIFS('0_Donnees_Brutes'!D:D, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & ")" & _
                "), """")"
        Next j
    Next i

    ' -------------------------------------------------------------
    ' 4. ÉTAPE 2 : CALCUL DU TAUX A PRIORI (ONGLET HYPOTHÈSES)
    ' -------------------------------------------------------------
    wsHyp.Cells.Clear
    wsHyp.Range("A1").Value = "CALIBRAGE S/P A PRIORI HISTORIQUE"
    wsHyp.Range("A1").Font.Bold = True
    
    wsHyp.Range("A3").Value = "Génération Début :"
    wsHyp.Cells(3, 2).Value = genMin
    wsHyp.Range("A4").Value = "Génération Fin (Périmètre Mature) :"
    wsHyp.Cells(4, 2).Value = genMaxMature
    
    wsHyp.Range("A6").Value = "Taux S/P A Priori (Moyenne Pondérée Matures) :"
    wsHyp.Range("A6").Font.Bold = True
    
    ' Taux S/P A Priori = Total Sinistres (Col E) / Total Primes (Col D) sur Générations Matures
    wsHyp.Cells(6, 2).Formula = "=SUMIFS('0_Donnees_Brutes'!E:E, '0_Donnees_Brutes'!A:A, ""<=" & genMaxMature & """) / " & _
                                "SUMIFS('0_Donnees_Brutes'!D:D, '0_Donnees_Brutes'!A:A, ""<=" & genMaxMature & """)"
    wsHyp.Cells(6, 2).NumberFormat = "0.00%"
    wsHyp.Cells(6, 2).Font.Bold = True

    ' -------------------------------------------------------------
    ' 5. ÉTAPE 3 : ÉCRITURE DE LA LIGNE DE CADENCE CUMULÉE
    ' -------------------------------------------------------------
    rowCadence = numGens + 3
    wsTri.Cells(rowCadence, 1).Value = "Cadence Cumulée Moyenne"
    wsTri.Cells(rowCadence, 1).Font.Bold = True
    
    colUltLetter = Split(wsTri.Cells(1, 16).Address, "$")(1) ' Colonne P (Y15)
    
    ' Calcul de la cadence sur le périmètre des générations matures
    Dim rowEndMature As Long
    rowEndMature = genMaxMature - genMin + 2
    
    For j = 1 To 15
        colCurLetter = Split(wsTri.Cells(1, j + 1).Address, "$")(1)
        
        ' Cadence Y_j = Moyenne(S/P_Yj) / Moyenne(S/P_Y15) sur les générations matures
        wsTri.Cells(rowCadence, j + 1).Formula = "=AVERAGE(" & colCurLetter & "2:" & colCurLetter & rowEndMature & ") / " & _
                                                 "AVERAGE(" & colUltLetter & "2:" & colUltLetter & rowEndMature & ")"
        wsTri.Cells(rowCadence, j + 1).NumberFormat = "0.00%"
        wsTri.Cells(rowCadence, j + 1).Font.Bold = True
    Next j

    ' -------------------------------------------------------------
    ' 6. ÉTAPE 4 : COMPLÉTION DU TRIANGLE PROJETÉ (FORMULES BF)
    ' -------------------------------------------------------------
    For i = 1 To numGens
        gen = genMin + i - 1
        yObsGen = genMax - gen + 1
        If yObsGen > 15 Then yObsGen = 15
        
        If yObsGen < 15 Then
            colObsLetter = Split(wsTri.Cells(1, yObsGen + 1).Address, "$")(1)
            
            For j = (yObsGen + 1) To 15
                colCurLetter = Split(wsTri.Cells(1, j + 1).Address, "$")(1)
                
                ' Formule BF Additive :
                ' S/P_Projeté = S/P_Observé(Yobs) + S/P_A_Priori * (Cadence(Y_j) - Cadence(Y_obs)) / Cadence(Y15)
                wsTri.Cells(i + 1, j + 1).Formula = "=" & colObsLetter & (i + 1) & " + " & _
                    "('1_Hypotheses_et_Calibrage'!$B$6 * (" & colCurLetter & "$" & rowCadence & " - " & colObsLetter & "$" & rowCadence & ") / P$" & rowCadence & ")"
                
                ' Stylisation de la cellule projetée
                wsTri.Cells(i + 1, j + 1).Font.Color = RGB(0, 80, 160)
            Next j
        End If
    Next i

    ' -------------------------------------------------------------
    ' 7. MISE EN FORME FINALE DU TABLEAU
    ' -------------------------------------------------------------
    wsTri.Range(wsTri.Cells(2, 2), wsTri.Cells(numGens + 1, 16)).NumberFormat = "0.00%"
    wsTri.Columns("A:P").AutoFit
    wsHyp.Columns("A:B").AutoFit
    
    Application.ScreenUpdating = True
    MsgBox "Projections Bornhuetter-Ferguson générées avec succès sans erreurs de référence !", vbInformation
End Sub
