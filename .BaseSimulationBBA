import numpy as np
import pandas as pd
import os
import json
from datetime import datetime


# =========================================================
# CONFIG
# =========================================================
def config():
    return {
        "n": 10000,
        "seed": 42,
        "discount_rate": 0.01,
        "lapse_rate": 0.03,
        "inflation_fees": 0.02,
        "inflation_claims": 0.03,
        "data_quality_rate": 0.12,
        "output_dir": "./output_data"
    }


def run_metadata():
    return {
        "run_id": datetime.now().strftime("%Y%m%d_%H%M%S"),
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }


# =========================================================
# BASE PORTFOLIO
# =========================================================
def build_base(n, rng):

    df = pd.DataFrame()

    df["contrat_id"] = [f"C{i:06d}" for i in range(n)]
    df["assure_id"] = [f"A{i:06d}" for i in range(n)]

    # socio demo
    df["age"] = rng.integers(18, 80, n)
    df["sexe"] = rng.choice(["H", "F"], n, p=[0.49, 0.51])
    df["revenu"] = np.clip(rng.normal(35000, 15000, n), 8000, 200000)

    df["profession"] = rng.choice(
        ["cadre", "employe", "ouvrier", "independant", "retraite"],
        n,
        p=[0.25, 0.35, 0.2, 0.1, 0.1]
    )

    df["statut_marital"] = rng.choice(
        ["celibataire", "marie", "divorce", "veuf"],
        n,
        p=[0.4, 0.45, 0.1, 0.05]
    )

    df["nb_enfants"] = np.clip(rng.poisson(1.2, n), 0, 5)

    df["region"] = rng.choice(["Nord", "Sud", "Est", "Ouest", "IDF"], n)

    # produit BBA protection only
    df["produit"] = rng.choice(
        ["emprunteur_immo", "emprunteur_conso", "protection_individuelle"],
        n,
        p=[0.45, 0.25, 0.30]
    )

    # contract structure
    df["generation_contrat"] = np.where(
        df["produit"] == "emprunteur_immo",
        rng.integers(2010, 2020, n),
        np.where(
            df["produit"] == "emprunteur_conso",
            rng.integers(2015, 2024, n),
            rng.integers(2018, 2026, n)
        )
    )

    df["souscription_mois"] = rng.integers(1, 13, n)

    df["duration"] = np.clip(
        np.where(
            df["produit"] == "emprunteur_immo", rng.normal(12, 3, n),
            np.where(df["produit"] == "emprunteur_conso", rng.normal(5, 2, n),
                     rng.normal(7, 2, n))
        ),
        1, 20
    ).astype(int)

    return df


# =========================================================
# EXPECTED FLOWS
# =========================================================
def compute_expected(df, rng):

    prof_factor = df["profession"].map({
        "cadre": 1.3,
        "employe": 1.0,
        "ouvrier": 0.9,
        "independant": 1.4,
        "retraite": 0.8
    }).values

    fam_factor = df["statut_marital"].map({
        "celibataire": 1.1,
        "marie": 0.95,
        "divorce": 1.2,
        "veuf": 1.0
    }).values

    enfant_factor = 1 + 0.03 * df["nb_enfants"].values

    product_factor = df["produit"].map({
        "emprunteur_immo": 1.3,
        "emprunteur_conso": 1.0,
        "protection_individuelle": 1.1
    }).values

    prime = (
        250 + df["age"].values * 9 + df["revenu"].values * 0.01
    ) * prof_factor * fam_factor * enfant_factor * product_factor

    prime += rng.normal(0, 70, len(df))
    prime = np.clip(prime, 200, None)

    comm_rate = np.clip(rng.normal(0.15, 0.03, len(df)), 0.05, 0.30)
    cost_rate = np.clip(rng.normal(0.06, 0.02, len(df)), 0.02, 0.15)

    df["prime_expected"] = prime
    df["commission_expected"] = prime * comm_rate
    df["frais_expected"] = prime * cost_rate

    freq = 0.04 + 0.07 * (df["nb_enfants"].values / 5)
    freq = np.clip(freq, 0.01, 0.25)

    claims_nb = rng.poisson(freq)
    severity = rng.gamma(2, 1100, len(df))
    df["sinistres_expected"] = claims_nb * severity

    df["acquisition_cf"] = prime * rng.uniform(0.02, 0.06, len(df))

    return df


# =========================================================
# INCURRED
# =========================================================
def compute_incurred(df, rng):

    df["prime_incurred"] = df["prime_expected"] * rng.normal(1, 0.02, len(df))
    df["commission_incurred"] = df["commission_expected"] * rng.normal(1, 0.05, len(df))
    df["frais_incurred"] = df["frais_expected"] * rng.normal(1, 0.08, len(df))

    df["sinistres_incurred"] = df["sinistres_expected"] * rng.lognormal(0, 0.35, len(df))

    df["gap_sinistres"] = df["sinistres_incurred"] - df["sinistres_expected"]

    return df


# =========================================================
# BBA ENGINE
# =========================================================
def bba_engine(row, r, lapse, infl_f, infl_c):

    T = row["duration"]

    pv_p = pv_c = pv_f = pv_s = pv_acq = 0
    survival = 1.0

    for t in range(1, T + 1):

        survival *= (1 - lapse)
        df = 1 / (1 + r) ** t

        pv_p += row["prime_expected"] * survival * df
        pv_c += row["commission_expected"] * survival * df
        pv_f += row["frais_expected"] * (1 + infl_f) ** t * df
        pv_s += row["sinistres_expected"] * (1 + infl_c) ** t * df
        pv_acq += row["acquisition_cf"] * df

    return pv_p, pv_c, pv_f, pv_s, pv_acq


def compute_bba(df, cfg):

    results = df.apply(
        lambda r: bba_engine(
            r,
            cfg["discount_rate"],
            cfg["lapse_rate"],
            cfg["inflation_fees"],
            cfg["inflation_claims"]
        ),
        axis=1
    )

    df[["pv_primes", "pv_comm", "pv_frais", "pv_sin", "pv_acq"]] = pd.DataFrame(
        results.tolist(),
        index=df.index
    )

    df["risk_adjustment"] = 0.20 * df["pv_sin"]

    df["csm"] = (
        df["pv_primes"]
        - df["pv_comm"]
        - df["pv_frais"]
        - df["pv_sin"]
        - df["risk_adjustment"]
        - df["pv_acq"]
    )

    df["csm"] = np.maximum(df["csm"], 0)

    return df


# =========================================================
# DATA QUALITY (10–15% pollution)
# =========================================================
def inject_quality(df, rng, rate=0.12):

    n = len(df)

    miss = int(rate * 0.4 * n)
    out = int(rate * 0.25 * n)
    incoh = int(rate * 0.25 * n)
    typo = int(rate * 0.1 * n)

    for col in ["revenu", "region", "profession", "statut_marital"]:
        idx = rng.choice(n, miss, replace=False)
        df.loc[idx, col] = np.nan

    idx = rng.choice(n, out, replace=False)
    df.loc[idx, "revenu"] *= rng.uniform(3, 10, len(idx))

    idx = rng.choice(n, out, replace=False)
    df.loc[idx, "age"] = rng.choice([-5, 0, 120, 999], len(idx))

    idx = rng.choice(n, incoh, replace=False)
    df.loc[idx, "commission_expected"] = df.loc[idx, "prime_expected"] * rng.uniform(1.2, 3, len(idx))

    idx = rng.choice(n, incoh, replace=False)
    df.loc[idx, "frais_expected"] *= -1

    idx = rng.choice(n, typo, replace=False)
    df.loc[idx, "region"] = rng.choice(["idf", "pariss", "IDF ", "Paris"], len(idx))

    return df


# =========================================================
# EXPORT
# =========================================================
def export(df, meta, cfg):

    os.makedirs(cfg["output_dir"], exist_ok=True)

    path = os.path.join(cfg["output_dir"], f"portfolio_{meta['run_id']}.csv")
    df.to_csv(path, index=False)

    with open(os.path.join(cfg["output_dir"], f"meta_{meta['run_id']}.json"), "w") as f:
        json.dump(meta, f, indent=4)

    return path


# =========================================================
# MAIN
# =========================================================
def main():

    cfg = config()
    rng = np.random.default_rng(cfg["seed"])
    meta = run_metadata()

    df = build_base(cfg["n"], rng)
    df = compute_expected(df, rng)
    df = compute_incurred(df, rng)
    df = compute_bba(df, cfg)
    df = inject_quality(df, rng, cfg["data_quality_rate"])

    file_path = export(df, meta, cfg)

    print("\n========================")
    print(" IFRS 17 SIMULATION DONE")
    print("========================")
    print("Run:", meta["run_id"])
    print("File:", file_path)
    print(df.head())


# =========================================================
# EXECUTION
# =========================================================
if __name__ == "__main__":
    main()
