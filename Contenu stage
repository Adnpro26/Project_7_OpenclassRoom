3. Recherche d'anomalies métier

Âges impossibles

df[(df["age"] < 18) | (df["age"] > 100)]

Revenus négatifs

df[df["revenu"] < 0]

Capital assuré nul

df[df["capital_assure"] <= 0]

Commissions supérieures aux primes

df[
    df["commission_expected"] >
    df["prime_expected"]
]

Frais négatifs

df[df["frais_expected"] < 0]

CSM négatives

df[df["csm"] < 0]

Risk Adjustment négatif

df[df["risk_adjustment"] < 0]

Age contrat supérieur à la durée

df[
    df["age_contrat"] >
    df["duration"]
]

Génération dans le futur

df[
    df["generation_contrat"] > 2026
]

Retraité de moins de 40 ans

df[
    (df["profession"]=="retraite")
    &
    (df["age"]<40)
]

