Sub GenererModeleComplet_2011_2025()
    Dim wb As Workbook
    Dim wsData As Worksheet, wsHyp As Worksheet, wsSP As Worksheet, wsFrais As Worksheet, wsRest As Worksheet
    Dim i As Integer, j As Integer
    Dim genStart As Integer
    Dim colCur As String, colPrev As String
    
    Set wb = ActiveWorkbook
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    ' Nettoyage des anciens onglets (garde un seul temporairement)
    Do While wb.Worksheets.Count > 1: wb.Worksheets(2).Delete: Loop
    
    ' Création de l'arborescence des 5 onglets
    Set wsData = wb.Worksheets(1): wsData.Name = "0_Donnees_Brutes"
    Set wsHyp = wb.Worksheets.Add(After:=wsData): wsHyp.Name = "1_Hypotheses_et_Calibrage"
    Set wsSP = wb.Worksheets.Add(After:=wsHyp): wsSP.Name = "2_Triangle_SP_Pur"
    Set wsFrais = wb.Worksheets.Add(After:=wsSP): wsFrais.Name = "3_Grille_Frais"
    Set wsRest = wb.Worksheets.Add(After:=wsFrais): wsRest.Name = "4_Restitution_et_Diagnostic"
    
    Application.DisplayAlerts = True
    genStart = 2011

    ' =========================================================
    ' 1. ONGLET 0 : DONNÉES BRUTES (2011 - 2025)
    ' =========================================================
    With wsData
        .Range("A1:G1").Value = Array("Génération", "Primes Acquises", "Sinistres Observés", "Commissions", "Frais Acquisition", "Frais Admin", "FGS")
        .Range("A1:G1").Font.Bold = True
        
        ' Alimentation des historiques 2011-2025
        For i = 0 To 14
            .Cells(i + 2, 1).Value = genStart + i
            .Cells(i + 2, 2).Value = 10000000 + (i * 500000)
            .Cells(i + 2, 3).Value = 6500000 + (i * 300000)
            .Cells(i + 2, 4).Value = 1000000 + (i * 50000)
            .Cells(i + 2, 5).Value = 500000 + (i * 20000)
            .Cells(i + 2, 6).Value = 300000 + (i * 10000)
            .Cells(i + 2, 7).Value = 200000 + (i * 8000)
        Next i
        
        ' Ligne de Totalisation
        .Cells(17, 1).Value = "TOTAL"
        .Cells(17, 1).Font.Bold = True
        For j = 2 To 7
            .Cells(17, j).Formula = "=SUM(" & Split(.Cells(2, j).Address, "$")(1) & "2:" & Split(.Cells(16, j).Address, "$")(1) & "16)"
            .Cells(17, j).Font.Bold = True
        Next j
        
        ' Triangle S/P Observé à profondeur variable (Profondeur = 2025 - Gen + 1)
        .Range("I1").Value = "TRIANGLE S/P OBSERVÉ (Profondeur = 2025 - Année Gen)"
        .Range("I1").Font.Bold = True
        .Range("I2").Value = "Génération"
        For j = 1 To 15: .Cells(2, j + 9).Value = "Y" & j: Next j
        
        For i = 0 To 14
            .Cells(i + 3, 9).Value = genStart + i
            For j = 1 To (15 - i)
                .Cells(i + 3, j + 9).Value = 0.60 + (0.04 / j)
            Next j
        Next i
        .Columns("A:X").AutoFit
    End With

    ' =========================================================
    ' 2. ONGLET 1 : HYPOTHÈSES ET CALIBRAGE RATIOS GLOBAUX
    ' =========================================================
    With wsHyp
        .Range("A1").Value = "INDICATEUR / RATIO GLOBAL": .Range("B1").Value = "FORMULE DE CALCUL": .Range("C1").Value = "VALEUR %"
        .Range("A1:C1").Font.Bold = True
        
        .Range("A2").Value = "Total Primes Acquises Historiques": .Range("B2").Value = "Somme Onglet 0": .Range("C2").Formula = "='0_Donnees_Brutes'!B17"
        .Range("A3").Value = "Total Sinistres Observés": .Range("B3").Value = "Somme Onglet 0": .Range("C3").Formula = "='0_Donnees_Brutes'!C17"
        .Range("A4").Value = "Total Commissions": .Range("B4").Value = "Somme Onglet 0": .Range("C4").Formula = "='0_Donnees_Brutes'!D17"
        .Range("A5").Value = "Total Frais Acquisition (AQE)": .Range("B5").Value = "Somme Onglet 0": .Range("C5").Formula = "='0_Donnees_Brutes'!E17"
        .Range("A6").Value = "Total Frais Admin": .Range("B6").Value = "Somme Onglet 0": .Range("C6").Formula = "='0_Donnees_Brutes'!F17"
        .Range("A7").Value = "Total Frais Gestion Sinistres (FGS)": .Range("B7").Value = "Somme Onglet 0": .Range("C7").Formula = "='0_Donnees_Brutes'!G17"
        
        .Range("A9").Value = "--- RATIOS MOYENS APLIQUÉS ---": .Range("A9").Font.Bold = True
        .Range("F5").Value = "Paramètre": .Range("G5").Value = "Ratio sur Primes"
        .Range("F5:G5").Font.Bold = True
        
        .Range("F6").Value = "Ratio Commissions": .Range("G6").Formula = "=C4/C2"
        .Range("F7").Value = "Ratio AQE": .Range("G7").Formula = "=C5/C2"
        .Range("F8").Value = "Ratio Admin": .Range("G8").Formula = "=C6/C2"
        .Range("F9").Value = "Ratio FGS": .Range("G9").Formula = "=C7/C2"
        
        .Range("C2:C7").NumberFormat = "#,##0 €"
        .Range("G6:G9").NumberFormat = "0.00%"
        .Columns("A:G").AutoFit
    End With

    ' =========================================================
    ' 3. ONGLET 2 : TRIANGLE S/P PUR (PROJECTION ET CADENCE)
    ' =========================================================
    With wsSP
        .Range("A1").Value = "TRIANGLE S/P PUR ET CADENCE DE LIQUIDATION"
        .Range("A2").Value = "Génération"
        For j = 1 To 15: .Cells(2, j + 1).Value = "Y" & j: Next j
        .Cells(2, 17).Value = "Ultime Y15"
        .Range("A2:Q2").Font.Bold = True
        
        ' Reprise de l'historique et complétion par Chain-Ladder ou recopie
        For i = 0 To 14
            .Cells(i + 3, 1).Value = genStart + i
            For j = 1 To 15
                If j <= (15 - i) Then
                    .Cells(i + 3, j + 1).Formula = "='0_Donnees_Brutes'!" & Split(.Cells(1, j + 9).Address, "$")(1) & (i + 3)
                Else
                    ' Maintien de la dernière valeur connue (hypothèse de liquidation atteinte)
                    .Cells(i + 3, j + 1).Formula = "=" & Split(.Cells(i + 3, j).Address, "$")(1) & (i + 3)
                End If
            Next j
            .Cells(i + 3, 17).Formula = "=P" & (i + 3)
        Next i
        
        ' Ligne de Cadence de Liquidation Moyenne (utilisée pour les clés d'écoulement FGS)
        .Cells(26, 1).Value = "Cadence Cumulée Moyenne"
        .Cells(26, 1).Font.Bold = True
        For j = 1 To 15
            .Cells(26, j + 1).Formula = "=AVERAGE(" & Split(.Cells(3, j + 1).Address, "$")(1) & "3:" & Split(.Cells(17, j + 1).Address, "$")(1) & "17)"
        Next j
        .Cells(26, 17).Formula = "=P26"
        .Range("B3:Q26").NumberFormat = "0.00%"
        .Columns("A:Q").AutoFit
    End With

    ' =========================================================
    ' 4. ONGLET 3 : GRILLE DE FRAIS BASÉE SUR LES DONNÉES OBSERVÉES
    ' =========================================================
    With wsFrais
        .Range("A1").Value = "NATURE DES FRAIS (Projection selon écoulement)"
        .Range("A1").Font.Bold = True
        For j = 1 To 15: .Cells(1, j + 1).Value = "Y" & j: Next j
        
        ' 1. Commissions (Lissées sur 15 ans)
        .Range("A2").Value = "Commissions"
        For j = 1 To 15
            .Cells(2, j + 1).Formula = "='1_Hypotheses_et_Calibrage'!$G$6 / 15"
        Next j
        
        ' 2. Frais d'Acquisition (AQE - 100% en Y1)
        .Range("A3").Value = "Frais d'Acquisition (AQE)"
        .Cells(3, 2).Formula = "='1_Hypotheses_et_Calibrage'!$G$7"
        For j = 2 To 15: .Cells(3, j + 1).Value = 0: Next j
        
        ' 3. Frais d'Administration (Lissés sur 15 ans)
        .Range("A4").Value = "Frais d'Administration"
        For j = 1 To 15
            .Cells(4, j + 1).Formula = "='1_Hypotheses_et_Calibrage'!$G$8 / 15"
        Next j
        
        ' 4. Frais de Gestion de Sinistres (Adossés à l'incrément du Triangle S/P)
        .Range("A5").Value = "Frais Gestion Sinistres (FGS)"
        .Cells(5, 2).Formula = "='1_Hypotheses_et_Calibrage'!$G$9 * ('2_Triangle_SP_Pur'!B26 / '2_Triangle_SP_Pur'!P26)"
        For j = 2 To 15
            colCur = Split(.Cells(1, j + 1).Address, "$")(1)
            colPrev = Split(.Cells(1, j).Address, "$")(1)
            .Cells(5, j + 1).Formula = "='1_Hypotheses_et_Calibrage'!$G$9 * (('2_Triangle_SP_Pur'!" & colCur & "26 - '2_Triangle_SP_Pur'!" & colPrev & "26) / '2_Triangle_SP_Pur'!P26)"
        Next j
        
        ' Total Frais par Maturité
        .Range("A6").Value = "TOTAL RATIO FRAIS"
        .Range("A6").Font.Bold = True
        For j = 1 To 15
            .Cells(6, j + 1).Formula = "=SUM(" & Split(.Cells(2, j + 1).Address, "$")(1) & "2:" & Split(.Cells(5, j + 1).Address, "$")(1) & "5)"
            .Cells(6, j + 1).Font.Bold = True
        Next j
        .Range("B2:P6").NumberFormat = "0.00%"
        .Columns("A:P").AutoFit
    End With

    ' =========================================================
    ' 5. ONGLET 4 : RESTITUTION DU COMBINED RATIO (Y1 À Y15)
    ' =========================================================
    With wsRest
        .Range("A1").Value = "COMBINED RATIO PROJETÉ (S/P PUR + FRAIS)"
        .Range("A2").Value = "Génération"
        For j = 1 To 15: .Cells(2, j + 1).Value = "Y" & j: Next j
        .Cells(2, 17).Value = "Combined Ratio Ultime (Y15)"
        .Range("A2:Q2").Font.Bold = True
        
        For i = 0 To 14
            .Cells(i + 3, 1).Value = genStart + i
            For j = 1 To 15
                colCur = Split(.Cells(1, j + 1).Address, "$")(1)
                ' Combined Ratio = Sinistralité S/P (Onglet 2) + Total Frais de la maturité (Onglet 3)
                .Cells(i + 3, j + 1).Formula = "='2_Triangle_SP_Pur'!" & colCur & (i + 3) & " + '3_Grille_Frais'!" & colCur & "$6"
            Next j
            .Cells(i + 3, 17).Formula = "=Q" & (i + 3) ' Valeur Ultime en Y15
        Next i
        
        .Range("B3:Q17").NumberFormat = "0.00%"
        .Columns("A:Q").AutoFit
    End With

    Application.ScreenUpdating = True
    MsgBox "Le modèle complet est prêt et les 5 onglets sont synchronisés !", vbInformation
End Sub
