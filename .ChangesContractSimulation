import numpy as np
import pandas as pd
import os
import json
from datetime import datetime

# =====================================================
# CONFIG
# =====================================================
def config():
    return {
        "n": 10000,
        "seed": 42,
        "discount_rate": 0.01,
        "lapse_rate": 0.03,
        "inflation_fees": 0.02,
        "inflation_claims": 0.03,
        "data_quality_rate": 0.13,
        "output_dir": "./output_data"
    }


def run_metadata():
    now = datetime.now()
    return {
        "run_id": now.strftime("%Y%m%d_%H%M%S"),
        "timestamp": now.strftime("%Y-%m-%d %H:%M:%S")
    }


# =====================================================
# BASE PORTFOLIO
# =====================================================
def build_base(n, rng):

    df = pd.DataFrame()

    df["contrat_id"] = [f"C{i:06d}" for i in range(n)]
    df["assure_id"] = [f"A{i:06d}" for i in range(n)]

    # socio-démo
    df["age"] = rng.integers(18, 80, n)
    df["sexe"] = rng.choice(["H", "F"], n, p=[0.49, 0.51])

    df["revenu"] = np.clip(rng.normal(35000, 15000, n), 8000, 200000)

    df["profession"] = rng.choice(
        ["cadre", "employe", "ouvrier", "independant", "retraite"],
        n, p=[0.25, 0.35, 0.20, 0.10, 0.10]
    )

    df["statut_marital"] = rng.choice(
        ["celibataire", "marie", "divorce", "veuf"],
        n, p=[0.40, 0.45, 0.10, 0.05]
    )

    df["nb_enfants"] = np.clip(rng.poisson(1.2, n), 0, 5)

    df["region"] = rng.choice(["Nord", "Sud", "Est", "Ouest", "IDF"], n)

    df["produit"] = rng.choice(
        ["emprunteur_immo", "emprunteur_conso", "protection_individuelle"],
        n, p=[0.45, 0.25, 0.30]
    )

    # génération contrat
    df["generation_contrat"] = np.where(
        df["produit"] == "emprunteur_immo",
        rng.integers(2010, 2020, n),
        np.where(
            df["produit"] == "emprunteur_conso",
            rng.integers(2015, 2024, n),
            rng.integers(2018, 2026, n)
        )
    )

    # durée
    duration = np.where(
        df["produit"] == "emprunteur_immo",
        rng.normal(12, 3, n),
        np.where(
            df["produit"] == "emprunteur_conso",
            rng.normal(5, 2, n),
            rng.normal(7, 2, n)
        )
    )

    df["duration"] = np.clip(duration, 1, 20).astype(int)

    # âge contrat
    ref_year = 2026
    df["age_contrat"] = np.clip(
        ref_year - df["generation_contrat"],
        0,
        df["duration"]
    )

    # capital assuré
    df["capital_assure"] = np.where(
        df["produit"] == "emprunteur_immo",
        rng.lognormal(12, 0.4, n),
        np.where(
            df["produit"] == "emprunteur_conso",
            rng.lognormal(10, 0.5, n),
            rng.lognormal(11, 0.5, n)
        )
    )

    return df


# =====================================================
# EXPECTED FLOWS
# =====================================================
def compute_expected(df, rng):

    prof_factor = df["profession"].map({
        "cadre": 1.3,
        "employe": 1.0,
        "ouvrier": 0.9,
        "independant": 1.4,
        "retraite": 0.8
    })

    prod_factor = df["produit"].map({
        "emprunteur_immo": 1.3,
        "emprunteur_conso": 1.0,
        "protection_individuelle": 1.1
    })

    base = (
        250
        + 0.0008 * df["capital_assure"]
        + 0.01 * df["revenu"]
        + 8 * df["age"]
    )

    prime = base * prof_factor * prod_factor
    prime += rng.normal(0, 70, len(df))
    prime = np.clip(prime, 200, None)

    comm_rate = np.clip(rng.normal(0.15, 0.03, len(df)), 0.05, 0.30)
    fee_rate = np.clip(rng.normal(0.06, 0.02, len(df)), 0.02, 0.15)

    df["prime_expected"] = prime
    df["commission_expected"] = prime * comm_rate
    df["frais_expected"] = prime * fee_rate

    freq = np.clip(
        0.03 + 0.02 * (df["age"] > 55) + 0.02 * (df["nb_enfants"] >= 3),
        0.01, 0.20
    )

    nb = rng.poisson(freq)
    sev = rng.gamma(2, 1500, len(df))

    df["sinistres_expected"] = nb * sev

    df["acquisition_cf"] = prime * rng.uniform(0.02, 0.06, len(df))

    return df


# =====================================================
# INCURRED
# =====================================================
def compute_incurred(df, rng):

    df["prime_incurred"] = df["prime_expected"] * rng.normal(1, 0.02, len(df))
    df["commission_incurred"] = df["commission_expected"] * rng.normal(1, 0.05, len(df))
    df["frais_incurred"] = df["frais_expected"] * rng.normal(1, 0.08, len(df))

    df["sinistres_incurred"] = df["sinistres_expected"] * rng.lognormal(0, 0.35, len(df))

    return df


# =====================================================
# BBA ENGINE
# =====================================================
def bba_engine(row, cfg):

    r = cfg["discount_rate"]
    lapse = cfg["lapse_rate"]
    infl_f = cfg["inflation_fees"]
    infl_c = cfg["inflation_claims"]

    T = row["duration"]

    pv_p = pv_c = pv_f = pv_s = pv_acq = 0
    surv = 1.0

    for t in range(1, T + 1):
        surv *= (1 - lapse)
        disc = (1 + r) ** (-t)

        pv_p += row["prime_expected"] * surv * disc
        pv_c += row["commission_expected"] * surv * disc
        pv_f += row["frais_expected"] * (1 + infl_f) ** t * disc
        pv_s += row["sinistres_expected"] * (1 + infl_c) ** t * disc
        pv_acq += row["acquisition_cf"] * disc

    return pd.Series([pv_p, pv_c, pv_f, pv_s, pv_acq])


def compute_bba(df, cfg):

    df[["pv_primes", "pv_comm", "pv_frais", "pv_sin", "pv_acq"]] = df.apply(
        lambda x: bba_engine(x, cfg),
        axis=1
    )

    df["risk_adjustment"] = 0.2 * df["pv_sin"]

    df["csm"] = (
        df["pv_primes"]
        - df["pv_comm"]
        - df["pv_frais"]
        - df["pv_sin"]
        - df["risk_adjustment"]
        - df["pv_acq"]
    )

    df["csm"] = np.maximum(df["csm"], 0)

    return df


# =====================================================
# COVERAGE + RELEASE
# =====================================================
def compute_release(df):

    df["coverage_unit"] = df["capital_assure"] * 1.1
    df["coverage_total"] = df["coverage_unit"] * df["duration"]

    ratio = np.clip(df["age_contrat"] / df["duration"], 0, 1)

    df["csm_released"] = df["csm"] * ratio
    df["ra_released"] = df["risk_adjustment"] * ratio

    df["csm_remaining"] = df["csm"] - df["csm_released"]
    df["ra_remaining"] = df["risk_adjustment"] - df["ra_released"]

    return df


# =====================================================
# DATA QUALITY + DOUBLONS + CHAOS
# =====================================================
def inject_quality(df, rng, rate=0.13):

    n = len(df)

    m = int(rate * n)

    # =========================
    # MISSING
    # =========================
    for col in ["revenu", "profession", "region", "capital_assure"]:
        idx = rng.choice(n, int(m * 0.3), replace=False)
        df.loc[idx, col] = np.nan

    # =========================
    # OUTLIERS
    # =========================
    idx = rng.choice(n, int(m * 0.2), replace=False)
    df.loc[idx, "age"] = rng.choice([120, 150, -5], len(idx))

    idx = rng.choice(n, int(m * 0.2), replace=False)
    df.loc[idx, "revenu"] *= rng.uniform(5, 20, len(idx))

    # =========================
    # INCOHERENCES
    # =========================
    idx = rng.choice(n, int(m * 0.2), replace=False)
    df.loc[idx, "age_contrat"] = df.loc[idx, "duration"] + rng.integers(1, 10, len(idx))

    idx = rng.choice(n, int(m * 0.1), replace=False)
    df.loc[idx, "generation_contrat"] = rng.integers(2027, 2035, len(idx))

    # =========================
    # FORMATS
    # =========================
    idx = rng.choice(n, int(m * 0.1), replace=False)
    df.loc[idx, "sexe"] = rng.choice(["H", "Homme", "M", "Femme"], len(idx))

    # =========================
    # DOUBLONS
    # =========================
    dup = df.sample(int(m * 0.1), random_state=42)
    dup["contrat_id"] = dup["contrat_id"] + "_DUP"
    df = pd.concat([df, dup], ignore_index=True)

    return df


# =====================================================
# EXPORT
# =====================================================
def export(df, meta, cfg):

    os.makedirs(cfg["output_dir"], exist_ok=True)

    path = os.path.join(cfg["output_dir"], f"portfolio_{meta['run_id']}.csv")
    df.to_csv(path, index=False)

    with open(os.path.join(cfg["output_dir"], f"meta_{meta['run_id']}.json"), "w") as f:
        json.dump(meta, f, indent=4)

    return path


# =====================================================
# MAIN
# =====================================================
def main():

    cfg = config()
    rng = np.random.default_rng(cfg["seed"])
    meta = run_metadata()

    df = build_base(cfg["n"], rng)
    df = compute_expected(df, rng)
    df = compute_incurred(df, rng)
    df = compute_bba(df, cfg)
    df = compute_release(df)
    df = inject_quality(df, rng, cfg["data_quality_rate"])

    file_path = export(df, meta, cfg)

    print("\n=== IFRS17 SIMULATION DONE ===")
    print("Run:", meta["run_id"])
    print("File:", file_path)
    print(df.head())


if __name__ == "__main__":
    main()
