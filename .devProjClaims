Option Explicit

Sub Generer_Projection_BF()
    Dim wsBrut As Worksheet, wsHyp As Worksheet, wsTri As Worksheet
    Dim lastRow As Long, i As Long, j As Long
    Dim gen As Long, mat As Long
    Dim genMin As Long, genMax As Long, numGens As Long
    Dim matMinMature As Long
    
    ' --- CONFIGURATION DES FEUILLES ---
    On Error Resume Next
    Set wsBrut = ThisWorkbook.Sheets("0_Donnees_Brutes")
    Set wsHyp = ThisWorkbook.Sheets("1_Hypotheses_et_Calibrage")
    Set wsTri = ThisWorkbook.Sheets("2_Triangle_SP_Pur")
    On Error GoTo 0
    
    If wsBrut Is Nothing Then
        MsgBox "Feuille '0_Donnees_Brutes' introuvable !", vbCritical
        Exit Sub
    End If
    
    ' Création des onglets si absents
    If wsHyp Is Nothing Then
        Set wsHyp = ThisWorkbook.Sheets.Add(After:=wsBrut)
        wsHyp.Name = "1_Hypotheses_et_Calibrage"
    End If
    If wsTri Is Nothing Then
        Set wsTri = ThisWorkbook.Sheets.Add(After:=wsHyp)
        wsTri.Name = "2_Triangle_SP_Pur"
    End If
    
    ' --- PARAMÉTRAGE ---
    matMinMature = 5 ' Nombre d'années de maturité minimales pour le calcul de l'a priori
    
    Application.ScreenUpdating = False
    
    ' 1. Recherche des générations min/max
    lastRow = wsBrut.Cells(wsBrut.Rows.Count, 1).End(xlUp).Row
    genMin = 9999
    genMax = 0
    
    For i = 2 To lastRow
        gen = wsBrut.Cells(i, 1).Value ' Col A: Génération
        If gen < genMin And gen > 1900 Then genMin = gen
        If gen > genMax Then genMax = gen
    Next i
    numGens = genMax - genMin + 1

    ' --- PARAMÈTRES ET HYPOTHÈSES ---
    wsHyp.Cells.Clear
    wsHyp.Range("A1").Value = "PARAMÈTRES ET CALIBRAGE A PRIORI"
    wsHyp.Range("A1").Font.Bold = True
    
    wsHyp.Range("A3").Value = "Génération Début :"
    wsHyp.Cells(3, 2).Value = genMin
    wsHyp.Range("A4").Value = "Génération Fin :"
    wsHyp.Cells(4, 2).Value = genMax
    wsHyp.Range("A5").Value = "Seuil Maturité A Priori (années) :"
    wsHyp.Cells(5, 2).Value = matMinMature
    
    ' Formule S/P A Priori : Moyenne pondérée Sinistres/Primes des générations matures
    wsHyp.Range("A7").Value = "Taux S/P A Priori Calibré :"
    wsHyp.Range("A7").Font.Bold = True
    
    ' Plage des générations matures (ex: <= genMax - matMinMature)
    Dim genMaxMature As Long
    genMaxMature = genMax - matMinMature + 1
    
    wsHyp.Cells(7, 2).Formula = "=SUMIFS('0_Donnees_Brutes'!H:H, '0_Donnees_Brutes'!A:A, ""<=" & genMaxMature & """) / " & _
                                "SUMIFS('0_Donnees_Brutes'!G:G, '0_Donnees_Brutes'!A:A, ""<=" & genMaxMature & """)"
    wsHyp.Cells(7, 2).NumberFormat = "0.00%"
    wsHyp.Cells(7, 2).Font.Bold = True
    
    ' --- CONSTRUCTION DU TRIANGLE SP ---
    wsTri.Cells.Clear
    wsTri.Cells(1, 1).Value = "Génération / Maturité"
    
    ' Entêtes Maturités (Y1 à Y15)
    For j = 1 To 15
        wsTri.Cells(1, j + 1).Value = "Y" & j
    Next j
    
    ' Entêtes Générations & Injection des Données Réelles / Formules
    For i = 1 To numGens
        gen = genMin + i - 1
        wsTri.Cells(i + 1, 1).Value = gen
        
        Dim yObsGen As Long
        yObsGen = genMax - gen + 1 ' Dernier Y observé pour cette génération
        If yObsGen > 15 Then yObsGen = 15
        
        For j = 1 To 15
            If j <= yObsGen Then
                ' Donnée Réelle S/P Observée = SOMME(Sinistres) / SOMME(Primes)
                wsTri.Cells(i + 1, j + 1).Formula = "=SUMIFS('0_Donnees_Brutes'!H:H, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & ") / " & _
                                                    "NULLIF(SUMIFS('0_Donnees_Brutes'!G:G, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & "), 0)"
                ' Nettoyage division par zéro standard Excel
                wsTri.Cells(i + 1, j + 1).Formula = "=IFERROR(SUMIFS('0_Donnees_Brutes'!H:H, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & ") / " & _
                                                    "SUMIFS('0_Donnees_Brutes'!G:G, '0_Donnees_Brutes'!A:A, " & gen & ", '0_Donnees_Brutes'!C:C, " & j & "), """")"
            End If
        Next j
    Next i

    ' --- LIGNE DE CADENCE CUMULÉE MOYENNE ---
    Dim rowCadence As Long
    rowCadence = numGens + 3
    wsTri.Cells(rowCadence, 1).Value = "Cadence Cumulée Moyenne"
    wsTri.Cells(rowCadence, 1).Font.Bold = True
    
    ' Calcul de la cadence sur les générations matures (rapport S/P Yj sur S/P Ultime)
    For j = 1 To 15
        Dim colLetter As String
        colLetter = Split(wsTri.Cells(1, j + 1).Address, "$")(1)
        Dim colUltLetter As String
        colUltLetter = Split(wsTri.Cells(1, 16).Address, "$")(1)
        
        ' Formule cadence = Moyenne(S/P Y_j sur gén matures) / Moyenne(S/P Y15 sur gén matures)
        wsTri.Cells(rowCadence, j + 1).Formula = "=AVERAGE(" & colLetter & "2:" & colLetter & (genMaxMature - genMin + 2) & ") / " & _
                                                 "AVERAGE(" & colUltLetter & "2:" & colUltLetter & (genMaxMature - genMin + 2) & ")"
        wsTri.Cells(rowCadence, j + 1).NumberFormat = "0.00%"
    Next j

    ' --- INJECTION DES FORMULES BF EN CASÉS PROJETÉES ---
    For i = 1 To numGens
        gen = genMin + i - 1
        yObsGen = genMax - gen + 1
        If yObsGen > 15 Then yObsGen = 15
        
        If yObsGen < 15 Then
            Dim colObsLetter As String
            colObsLetter = Split(wsTri.Cells(1, yObsGen + 1).Address, "$")(1)
            
            For j = (yObsGen + 1) To 15
                Dim colCurLetter As String
                colCurLetter = Split(wsTri.Cells(1, j + 1).Address, "$")(1)
                
                ' Formule Bornhuetter-Ferguson explicite dans la cellule :
                ' S/P_Projeté(Yj) = S/P_Obs(Yobs) + S/P_APriori * (Cadence(Yj) - Cadence(Yobs)) / Cadence(Y15)
                wsTri.Cells(i + 1, j + 1).Formula = "=" & colObsLetter & (i + 1) & " + ('1_Hypotheses_et_Calibrage'!$B$7 * (" & _
                                                    colCurLetter & "$" & rowCadence & " - " & colObsLetter & "$" & rowCadence & ") / P$" & rowCadence & ")"
                wsTri.Cells(i + 1, j + 1).Font.Color = RGB(0, 70, 150) ' Distinction visuelle du projeté
            Next j
        End If
    Next i

    ' Mise en forme du tableau
    wsTri.Range(wsTri.Cells(2, 2), wsTri.Cells(numGens + 1, 16)).NumberFormat = "0.00%"
    wsTri.Columns("A:P").AutoFit
    
    Application.ScreenUpdating = True
    MsgBox "Projection Bornhuetter-Ferguson générée avec succès !", vbInformation
End Sub
